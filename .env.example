# ローカル開発用。コピーした .env に秘密情報を設定する。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskmanager
DB_USER=root
DB_PASSWORD=root
# openssl rand -hex 32 で生成した値を設定（UTF-8で32バイト以上）
JWT_SECRET=

# Compose専用（ホスト上のアプリ用DB_*とは別）
APP_PORT=8080
COMPOSE_DB_PASSWORD=local-taskapp-password
COMPOSE_DB_ROOT_PASSWORD=local-root-password
